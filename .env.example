# Server port inside the container
PORT=3000

# Max upload file size in bytes (default 100 MB)
MAX_FILE_SIZE=104857600
# Age in seconds before unfinalized upload files are removed (default 24 hours)
TEMP_FILE_MAX_AGE_SEC=86400

# Admin panel password (leave empty to disable admin)
ADMIN_PASSWORD=

# JWT secret — generate a unique value with: openssl rand -base64 48
JWT_SECRET=

# CORS origins — comma-separated list. Use the web domain and native client origin.
CORS_ORIGIN=https://chat.example.com,http://tauri.localhost,tauri://localhost
# Optional Fastify proxy trust. Leave unset unless nginx is the direct trusted proxy.
TRUST_PROXY=
COOKIE_SECURE=true
COOKIE_SAMESITE=none
DOMAIN=chat.example.com

# Public VPS IPv4 used by mediasoup ICE candidates.
MEDIASOUP_ANNOUNCED_IP=203.0.113.10

# Paths (defaults work inside Docker, change for local dev)
# UPLOADS_DIR=/app/uploads
# DB_PATH=/app/data/discord-clone.db
